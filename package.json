{
  "name": "@snowcss/root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/**' build",
    "build:watch": "pnpm --filter './packages/**' build:watch",
    "changeset": "changeset",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "playground:build": "pnpm --filter @snowcs/playground build",
    "playground:dev": "pnpm --filter @snowcss/playground dev",
    "prepare": "lefthook install",
    "release": "pnpm build && changeset publish",
    "test": "pnpm --parallel --filter './packages/**' test",
    "typecheck": "pnpm --parallel --filter './packages/**' typecheck",
    "version": "changeset version",
    "vscode:build": "pnpm --filter './editors/vscode' build",
    "vscode:package": "pnpm --filter './editors/vscode' package"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8",
    "@snowcss/lsp": "workspace:",
    "lefthook": "2.0.12",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.29.1"
}
